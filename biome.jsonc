{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/target",
      "!**/src-tauri/target",
      // The approved art-direction sheet of ADR 0018 is a drawing of screens, not interface code:
      // its placeholder anchors, icon svgs and buttons are never shipped, and marking them up as
      // production a11y would edit an artifact the user signed off on. Pinned to the one file, the
      // way the caption exemption of ADR 0017 is pinned.
      "!**/docs/design/night-cinema-mockup.html",
      "!**/.agents",
      "!**/.qoder",
      "!**/src-tauri/gen",
      "!**/docs/anilibria/openapi.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  },
  // The catalog delivers no text track, so the player renders no caption track and
  // lint/a11y/useMediaCaption has nothing it could accept instead (ADR 0017). The rule stays on
  // for every other file: a media element added elsewhere is still gated.
  "overrides": [
    {
      "includes": ["**/src/features/player/ui/PlayerVideoViewport.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useMediaCaption": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
